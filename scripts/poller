#!/usr/bin/env bash
set -euo pipefail

config_file=${TRANSCRIBER_CONFIG:-/etc/transcriber/config}

declare -A config=()

read_config() {
  local line key value

  [[ -r "$config_file" ]] || return 0

  while IFS= read -r line || [[ -n "$line" ]]; do
    # Ignore comments and empty lines.
    [[ "$line" =~ ^[[:space:]]*(#|$) ]] && continue

    if [[ "$line" != *=* ]]; then
      printf 'Invalid configuration line in %s: %s\n' \
        "$config_file" "$line" >&2
      return 1
    fi

    key=${line%%=*}
    value=${line#*=}

    # Trim surrounding whitespace from the key.
    key=${key#"${key%%[![:space:]]*}"}
    key=${key%"${key##*[![:space:]]}"}

    case "$key" in
      runtime_dir | state_dir | output_dir | sources_file | request_delay | video_delay | git_enabled | git_remote | git_branch | git_author_name | git_author_email | git_commit_message)
        config["$key"]=$value
        ;;
      *)
        printf 'Unknown configuration key in %s: %s\n' \
          "$config_file" "$key" >&2
        return 1
        ;;
    esac
  done < "$config_file"
}

read_config

output_dir=${TRANSCRIBER_OUTPUT_DIR:-${config[output_dir]:-/var/lib/transcriber/output}}
sources_file=${TRANSCRIBER_SOURCES:-${config[sources_file]:-/etc/transcriber/sources.txt}}
runtime_dir=${TRANSCRIBER_RUNTIME_DIR:-${TRANSCRIBER_STATE_DIR:-${config[runtime_dir]:-${config[state_dir]:-/var/lib/transcriber}}}}

request_delay=${TRANSCRIBER_REQUEST_DELAY:-${config[request_delay]:-1}}
video_delay=${TRANSCRIBER_VIDEO_DELAY:-${config[video_delay]:-10}}
retry_missing_subtitles=${TRANSCRIBER_RETRY_MISSING_SUBTITLES:-false}

git_enabled=${TRANSCRIBER_GIT_ENABLED:-${config[git_enabled]:-false}}
git_remote=${TRANSCRIBER_GIT_REMOTE:-${config[git_remote]:-}}
git_branch=${TRANSCRIBER_GIT_BRANCH:-${config[git_branch]:-main}}
git_commit_message=${TRANSCRIBER_GIT_COMMIT_MESSAGE:-${config[git_commit_message]:-Transcriber output}}
git_author_name=${TRANSCRIBER_GIT_AUTHOR_NAME:-${config[git_author_name]:-Transcriber}}
git_author_email=${TRANSCRIBER_GIT_AUTHOR_EMAIL:-${config[git_author_email]:-transcriber@localhost}}

if [[ -n "${TRANSCRIBER_GIT_TOKEN:-}" ]]; then
  export GIT_ASKPASS=transcriber-git-askpass
  export GIT_TERMINAL_PROMPT=0
fi

for boolean_setting in git_enabled retry_missing_subtitles; do
  case "${!boolean_setting}" in
    true | false) ;;
    *)
      printf '%s must be true or false, got: %s\n' \
        "$boolean_setting" "${!boolean_setting}" >&2
      exit 1
      ;;
  esac
done

# These legacy files are read only so an upgrade does not reprocess everything.
# Newly discovered legacy entries are copied into the source-local state files.
legacy_successful_archive="$runtime_dir/processed.txt"
legacy_no_subs_archive="$runtime_dir/missing-english-subtitles.txt"
lock="$runtime_dir/poll.lock"

source_directory() {
  local source=$1 path

  # Keep YouTube channel names readable: @Channel/videos becomes
  # Channel. Other source URLs retain the portion after their host.
  path=${source#*://}
  path=${path#*/}
  path=${path%/}
  if [[ "$path" == @* ]]; then
    path=${path#@}
    path=${path%%/*}
  fi

  printf '%s\n' "$path"
}

sync_output_repository() {
  local ahead behind configured_remote

  if ! git check-ref-format --branch "$git_branch" >/dev/null; then
    echo "Invalid Git branch name: $git_branch" >&2
    return 1
  fi

  if ! git -C "$output_dir" rev-parse --git-dir >/dev/null 2>&1; then
    echo "Initializing Git repository in $output_dir"
    git -C "$output_dir" init --initial-branch="$git_branch"
  fi

  if git -C "$output_dir" remote get-url origin >/dev/null 2>&1; then
    configured_remote=$(git -C "$output_dir" remote get-url origin)
    if [[ -n "$git_remote" && "$configured_remote" != "$git_remote" ]]; then
      git -C "$output_dir" remote set-url origin "$git_remote"
    fi
  elif [[ -n "$git_remote" ]]; then
    git -C "$output_dir" remote add origin "$git_remote"
  else
    echo "git_remote must be configured when the output repository has no origin" >&2
    return 1
  fi

  git -C "$output_dir" fetch --prune origin

  if git -C "$output_dir" show-ref --verify --quiet "refs/remotes/origin/$git_branch"; then
    # The remote is canonical at the start of a run. Discard output left by an
    # interrupted run so it cannot obstruct checkout or become a later commit.
    if git -C "$output_dir" rev-parse --verify HEAD >/dev/null 2>&1; then
      git -C "$output_dir" reset --hard HEAD
    fi
    git -C "$output_dir" clean -fd

    if git -C "$output_dir" show-ref --verify --quiet "refs/heads/$git_branch"; then
      git -C "$output_dir" checkout "$git_branch"
    else
      git -C "$output_dir" checkout --track -b "$git_branch" "origin/$git_branch"
    fi

    read -r ahead behind < <(
      git -C "$output_dir" rev-list --left-right --count \
        "HEAD...origin/$git_branch"
    )
    if (( ahead > 0 && behind > 0 )); then
      echo "Local and remote branches diverged; replacing local $git_branch with origin/$git_branch"
      git -C "$output_dir" reset --hard "origin/$git_branch"
    fi

    # Pull on every run, including after a divergence reset. A local branch
    # that is only ahead is retained so a previously committed push can retry.
    git -C "$output_dir" pull --ff-only origin "$git_branch"
  else
    echo "Remote branch origin/$git_branch does not exist; it will be created on push"
    # Preserve pre-existing output when initializing against an empty remote,
    # but clean remnants if this repository already has committed history.
    if git -C "$output_dir" rev-parse --verify HEAD >/dev/null 2>&1; then
      git -C "$output_dir" reset --hard HEAD
      git -C "$output_dir" clean -fd
    fi
    if git -C "$output_dir" show-ref --verify --quiet "refs/heads/$git_branch"; then
      git -C "$output_dir" checkout "$git_branch"
    else
      git -C "$output_dir" checkout -b "$git_branch"
    fi
  fi

  git -C "$output_dir" config user.name "$git_author_name"
  git -C "$output_dir" config user.email "$git_author_email"
}

mkdir -p "$runtime_dir" "$output_dir"

exec 9>"$lock"

if ! flock -n 9; then
  echo "A transcriber poll is already running"
  exit 0
fi

if [[ "$git_enabled" == true ]]; then
  sync_output_repository
fi

transcriber_error=$(mktemp "$runtime_dir/.transcriber-error.XXXXXX")
remaining_no_subs=$(mktemp "$runtime_dir/.remaining-no-subs.XXXXXX")
trap 'rm -f "$transcriber_error" "$remaining_no_subs"' EXIT

# Bring output created by older transcriber versions onto the provenance
# contract without downloading or transcribing those videos again.
while IFS= read -r -d '' info_json; do
  video_directory=${info_json%/*}
  if [[ ! -f "$video_directory/id.txt" || ! -f "$video_directory/source.md" ]]; then
    echo "Backfilling provenance: $video_directory"
    transcriber-provenance "$info_json"
  fi
done < <(find "$output_dir" -type f -name source.info.json -print0)

while IFS= read -r source || [[ -n "$source" ]]; do
  # Ignore blank lines and comments.
  [[ -z "$source" || "$source" == \#* ]] && continue

  source_dir=$(source_directory "$source")
  source_state_dir="$output_dir/$source_dir/.state"
  mkdir -p "$source_state_dir"
  touch "$source_state_dir/successful.txt" "$source_state_dir/no-subs.txt"

  yt_dlp_args=(
    --ignore-config
    --no-warnings
    # Enumerate lightweight IDs for the whole source before transcribing.
    --flat-playlist
    --no-lazy-playlist
    --sleep-requests "$request_delay"
    --retry-sleep 'extractor:exp=2:30'
    --retry-sleep 'http:exp=2:30'
    --print $'%(id)s\t%(webpage_url)s'
  )

  echo "Discovering full history: $source" >&2

  yt-dlp "${yt_dlp_args[@]}" "$source" |
    while IFS=$'\t' read -r video_id video_url; do
      printf '%s\t%s\t%s\n' "$video_id" "$video_url" "$source_dir"
    done
done < "$sources_file" |
  awk -F $'\t' '!seen[$1]++' |
  {
    first_video=true
    while IFS=$'\t' read -r video_id video_url source_dir; do
      [[ -z "$video_id" || -z "$video_url" || -z "$source_dir" ]] && continue

      source_state_dir="$output_dir/$source_dir/.state"
      successful_archive="$source_state_dir/successful.txt"
      no_subs_archive="$source_state_dir/no-subs.txt"

      if [[ "$retry_missing_subtitles" == true ]]; then
        if ! grep -Fqx -- "$video_id" "$no_subs_archive"; then
          if [[ -f "$legacy_no_subs_archive" ]] && \
            grep -Fqx -- "$video_id" "$legacy_no_subs_archive"; then
            printf '%s\n' "$video_id" >> "$no_subs_archive"
            echo "Migrated legacy no-subs state: $video_id"
          else
            continue
          fi
        fi
      fi

      if grep -Fqx -- "$video_id" "$successful_archive"; then
        echo "Already processed: $video_id"
        continue
      fi

      if [[ -f "$legacy_successful_archive" ]] && \
        grep -Fqx -- "$video_id" "$legacy_successful_archive"; then
        printf '%s\n' "$video_id" >> "$successful_archive"
        echo "Migrated legacy successful state: $video_id"
        continue
      fi

      if [[ "$retry_missing_subtitles" == false ]]; then
        if grep -Fqx -- "$video_id" "$no_subs_archive"; then
          echo "Skipping video without English subtitles: $video_id"
          continue
        fi

        if [[ -f "$legacy_no_subs_archive" ]] && \
          grep -Fqx -- "$video_id" "$legacy_no_subs_archive"; then
          printf '%s\n' "$video_id" >> "$no_subs_archive"
          echo "Migrated legacy no-subs state: $video_id"
          continue
        fi
      fi

      if [[ "$first_video" == false ]]; then
        sleep "$video_delay"
      fi
      first_video=false

      if [[ "$retry_missing_subtitles" == true ]]; then
        echo "Retrying $video_id: $video_url"
      else
        echo "Processing $video_id: $video_url"
      fi
      : > "$transcriber_error"

      if (
        mkdir -p "$output_dir/$source_dir"
        cd "$output_dir/$source_dir"
        transcriber "$video_url" 2> "$transcriber_error"
      ); then
        cat "$transcriber_error" >&2
        printf '%s\n' "$video_id" >> "$successful_archive"
        if grep -Fqx -- "$video_id" "$no_subs_archive"; then
          awk -v video_id="$video_id" '$0 != video_id' \
            "$no_subs_archive" > "$remaining_no_subs"
          mv "$remaining_no_subs" "$no_subs_archive"
          remaining_no_subs=$(mktemp "$runtime_dir/.remaining-no-subs.XXXXXX")
        fi
      else
        cat "$transcriber_error" >&2
        if grep -Fq 'Could not find the downloaded English VTT subtitle:' "$transcriber_error"; then
          if ! grep -Fqx -- "$video_id" "$no_subs_archive"; then
            printf '%s\n' "$video_id" >> "$no_subs_archive"
            echo "Recorded missing English subtitles: $video_id" >&2
          fi
        fi
        echo "Failed to process $video_id" >&2
      fi
    done
  }

if [[ "$git_enabled" == true ]]; then
  git -C "$output_dir" add -A
  if git -C "$output_dir" diff --cached --quiet; then
    echo "No transcript changes to commit"
  else
    # Scheduled jobs cannot satisfy interactive GPG or hardware-key prompts
    # from a host-level Git configuration.
    git -C "$output_dir" -c commit.gpgSign=false commit -m "$git_commit_message"
  fi

  # Push even when this run produced no commit. This retries a commit left
  # ahead by an earlier run whose push failed.
  git -C "$output_dir" push --set-upstream origin "$git_branch"
fi
